---
// index.astro - TIDE Official Website (DevThread Layout Reference)
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import PixelLogoHero from '../components/PixelLogoHero.astro';
import SectionProblem from '../components/devthread/SectionProblem.astro';
import SectionWorkflow from '../components/devthread/SectionWorkflow.astro';
import SectionWhatYouKeep from '../components/devthread/SectionWhatYouKeep.astro';
import SectionConcreteWorkspace from '../components/devthread/SectionConcreteWorkspace.astro';
import ThemePreviewer from '../components/ThemePreviewer.astro';
import SectionCompatibility from '../components/devthread/SectionCompatibility.astro';
import SectionOpenSource from '../components/devthread/SectionOpenSource.astro';
import Footer from '../components/Footer.astro';
import ShortcutsModal from '../components/ShortcutsModal.astro';
---

<!doctype html>
<html lang="en" data-theme="tide-ocean" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TIDE — Terminal Integrated Development Environment for Parallel Coding Agents</title>
    <meta
      name="description"
      content="A native, keyboard-first terminal workspace in Rust for orchestrating parallel coding agents in isolated Git worktrees with hardened Windows process teardown and 60 FPS PTY emulation."
    />
    
    <!-- Open Graph / Meta -->
    <meta property="og:title" content="TIDE — Terminal IDE for Parallel Coding Agents" />
    <meta property="og:description" content="Orchestrate local coding agents in dedicated Git worktrees with hardened Windows process teardown. Zero Electron. Zero browser overhead." />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-tide-bg text-tide-text font-mono antialiased selection:bg-tide-accent/20 selection:text-tide-accent scanlines">
    <!-- Navbar -->
    <Navbar />

    <!-- Main Content -->
    <main>
      <!-- Hero Section (DevThread Layout) -->
      <section id="hero" class="relative pt-12 pb-20 border-b border-tide-border terminal-grid overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
          
          <!-- Big Animated Pixelated Wave Logo on Top -->
          <div class="mb-8">
            <PixelLogoHero />
          </div>

          <!-- Eyebrow (DevThread Style) -->
          <div class="text-xs uppercase tracking-widest text-tide-accent font-mono flex items-center justify-center gap-2 mb-4">
            <span class="text-tide-muted select-none">—</span>
            <span>TERMINAL INTEGRATED DEVELOPMENT ENVIRONMENT (TIDE)</span>
            <span class="text-tide-muted select-none">—</span>
          </div>

          <!-- Main Headline (DevThread Bold High-Impact Style) -->
          <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-tide-text leading-[1.1] font-mono">
            An IDE inside your terminal.<br />
            <span class="text-tide-accent">Built for parallel AI agents.</span>
          </h1>

          <!-- Sub-headline -->
          <div class="text-lg sm:text-xl font-semibold text-tide-text font-sans mt-5 max-w-2xl">
            Stop switching between five terminal tabs, editors, and Git apps.
          </div>

          <!-- Description -->
          <p class="text-sm sm:text-base text-tide-text-secondary leading-relaxed font-sans max-w-2xl mt-4">
            TIDE integrates shell sessions, parallel coding agents, and side-by-side code diffs into one fast, keyboard-first terminal workspace. Each agent works in an isolated copy of your code so they never fight over files or break your main branch.
          </p>

          <!-- Action Row: Primary Button + Text Link -->
          <div class="flex flex-wrap items-center justify-center gap-4 mt-8 font-mono text-xs">
            <a
              href="#install"
              class="px-6 py-3 rounded bg-tide-accent text-tide-bg font-bold hover:brightness-110 transition-all flex items-center gap-1.5 shadow-md shadow-tide-accent/25 hover:shadow-tide-accent/40 hover:-translate-y-0.5"
            >
              <span>Install TIDE</span>
              <span>↗</span>
            </a>

            <a
              href="#how-it-works"
              class="px-5 py-3 rounded border border-tide-border bg-tide-surface text-tide-text-secondary hover:text-tide-accent hover:border-tide-border-active transition-all flex items-center gap-1"
            >
              <span>See how it works</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- Quick Install Command Box (DevThread Style) -->
          <div class="mt-8 max-w-xl w-full">
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-tide-surface border border-tide-border hover:border-tide-border-active transition-all group shadow-sm font-mono text-xs">
              <div class="flex items-center gap-2 truncate pl-1">
                <span class="text-tide-accent select-none">&gt;</span>
                <code id="hero-cmd-display" class="text-tide-text font-bold text-xs select-all truncate">
                  cargo install --git https://github.com/kurarensu16/TIDE
                </code>
              </div>
              <button
                id="hero-copy-btn"
                class="ml-2 px-3 py-1 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-xs transition-colors shrink-0"
                data-copy="cargo install --git https://github.com/kurarensu16/TIDE"
              >
                Copy
              </button>
            </div>

            <!-- Footnote Info -->
            <div class="mt-3 text-[11px] text-tide-muted font-mono flex items-center justify-center gap-2 flex-wrap">
              <span>Lightweight single binary</span>
              <span>&middot;</span>
              <span>Starts in &lt;0.5s</span>
              <span>&middot;</span>
              <span>Uses ~14 MB RAM</span>
              <span>&middot;</span>
              <span>Zero Electron bloat</span>
            </div>
          </div>

        </div>
      </section>

      <!-- DevThread-style metadata strip below Hero -->
      <section class="border-b border-tide-border bg-tide-surface/60 py-3 text-xs font-mono text-tide-muted">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
          <div class="flex items-center gap-3">
            <span>TERMINAL IDE</span>
            <span class="hidden sm:inline">&middot;</span>
            <span>OPEN SOURCE &middot; MIT</span>
            <span class="hidden sm:inline">&middot;</span>
            <span class="hidden sm:inline">NO GHOST PROCESSES</span>
            <span class="hidden sm:inline">&middot;</span>
            <span class="hidden sm:inline">SMOOTH 60 FPS</span>
            <span class="hidden sm:inline">&middot;</span>
            <span class="hidden sm:inline">~14 MB RAM</span>
          </div>
          <a href="#how-it-works" class="text-tide-text-secondary hover:text-tide-accent transition-colors flex items-center gap-1">
            <span>Explore how it works</span>
            <span>&darr;</span>
          </a>
        </div>
      </section>

      <!-- 01 / THE PROBLEM -->
      <SectionProblem />

      <!-- 02 / THE WORKFLOW -->
      <SectionWorkflow />

      <!-- 03 / WHAT YOU KEEP -->
      <SectionWhatYouKeep />

      <!-- 04 / A CONCRETE WORKSPACE (Interactive Ratatui Simulation) -->
      <SectionConcreteWorkspace />

      <!-- 05 / THEMES & RATATUI PALETTES -->
      <ThemePreviewer />

      <!-- 06 / COMPATIBILITY & SYSTEMS EVIDENCE -->
      <SectionCompatibility />

      <!-- 07 / OPEN SOURCE & GETTING STARTED (Centered Callout) -->
      <SectionOpenSource />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Keyboard Shortcuts Cheatsheet Modal -->
    <ShortcutsModal />

    <!-- Hero Command Copy Script -->
    <script>
      const heroCopyBtn = document.getElementById('hero-copy-btn');
      heroCopyBtn?.addEventListener('click', () => {
        const text = heroCopyBtn.getAttribute('data-copy');
        if (text) {
          navigator.clipboard.writeText(text);
          const original = heroCopyBtn.textContent;
          heroCopyBtn.textContent = 'Copied!';
          heroCopyBtn.classList.add('text-tide-success');
          setTimeout(() => {
            heroCopyBtn.textContent = original;
            heroCopyBtn.classList.remove('text-tide-success');
          }, 1800);
        }
      });
    </script>
  </body>
</html>
