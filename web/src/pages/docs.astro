    <!-- Copy doc code script & Search highlight script -->
    <script>
      const copyBtns = document.querySelectorAll('.copy-doc-btn');
      copyBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const text = btn.getAttribute('data-copy');
          if (text) {
            navigator.clipboard.writeText(text);
            const orig = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('text-tide-success');
            setTimeout(() => {
              btn.textContent = orig;
              btn.classList.remove('text-tide-success');
            }, 1800);
          }
        });
      });

      // Quick Search input filter
      const searchInput = document.getElementById('docs-search-input') as HTMLInputElement | null;
      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        const sections = document.querySelectorAll('.doc-section');
        sections.forEach((sec) => {
          const text = (sec as HTMLElement).innerText.toLowerCase();
          if (!query || text.includes(query)) {
            (sec as HTMLElement).style.display = '';
          } else {
            (sec as HTMLElement).style.display = 'none';
          }
        });
      });

      // Hotkey Ctrl+K to focus search
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          searchInput?.focus();
        }
      });
    </script>
