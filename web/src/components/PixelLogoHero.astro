---
// PixelLogoHero.astro - Big Animated Pixelated TIDE Logo
---

<div class="relative flex items-center justify-center select-none group">
  <!-- Ambient phosphor bloom backlight behind logo -->
  <div class="absolute w-56 h-56 sm:w-72 sm:h-72 rounded-full bg-tide-accent/25 blur-3xl pointer-events-none logo-bloom"></div>
  
  <!-- Subtle secondary deep blue aura -->
  <div class="absolute w-40 h-40 sm:w-56 sm:h-56 rounded-full bg-blue-600/20 blur-2xl pointer-events-none"></div>

  <!-- The Animated Pixelated Wave Logo -->
  <div class="relative z-10 logo-container">
    <img
      src="/tide-pixel-large.png"
      alt="TIDE Pixelated Logo"
      class="w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 object-contain pixel-logo transition-transform duration-300 group-hover:scale-105"
      style="image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges;"
      loading="eager"
      width="256"
      height="256"
    />
  </div>
</div>

<style>
  /* Smooth floating wave animation */
  @keyframes pixel-float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-8px) rotate(-1deg);
    }
    50% {
      transform: translateY(-14px) rotate(0deg);
    }
    75% {
      transform: translateY(-6px) rotate(1deg);
    }
  }

  /* Breathing phosphor glow */
  @keyframes pixel-glow {
    0%, 100% {
      filter: drop-shadow(0 0 16px rgba(56, 189, 248, 0.45))
              drop-shadow(0 0 35px rgba(56, 189, 248, 0.25));
    }
    50% {
      filter: drop-shadow(0 0 28px rgba(56, 189, 248, 0.8))
              drop-shadow(0 0 55px rgba(56, 189, 248, 0.4))
              drop-shadow(0 0 80px rgba(37, 99, 235, 0.25));
    }
  }

  /* Ambient bloom breathing */
  @keyframes bloom-breathe {
    0%, 100% {
      opacity: 0.5;
      transform: scale(0.95);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.1);
    }
  }

  .logo-container {
    animation: pixel-float 5s ease-in-out infinite;
    will-change: transform;
  }

  .pixel-logo {
    animation: pixel-glow 3.5s ease-in-out infinite;
    will-change: filter;
  }

  .logo-bloom {
    animation: bloom-breathe 4s ease-in-out infinite;
    will-change: transform, opacity;
  }
</style>
