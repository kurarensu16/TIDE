---
// Footer.astro
---

<footer class="border-t border-tide-border bg-tide-surface text-xs font-mono text-tide-text-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Brand & Logo -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded border border-tide-border flex items-center justify-center bg-tide-bg p-0.5">
            <img src="/logo.svg" alt="TIDE Wave" class="w-full h-full object-contain" />
          </div>
          <span class="font-bold text-sm text-tide-text">TIDE</span>
        </div>
        <p class="text-xs text-tide-muted leading-relaxed font-sans">
          Terminal Integrated Development Environment for Parallel Coding-Agent Management.
        </p>
        <div class="text-[11px] text-tide-accent font-mono">
          Built in Rust stable • Windows 11 ConPTY
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-tide-text">Navigation</div>
        <ul class="space-y-1.5 text-[11px] text-tide-muted">
          <li><a href="/#how-it-works" class="hover:text-tide-accent transition-colors">How it works</a></li>
          <li><a href="/#the-problem" class="hover:text-tide-accent transition-colors">The Problem</a></li>
          <li><a href="/#what-you-keep" class="hover:text-tide-accent transition-colors">Benefits</a></li>
          <li><a href="/#workspace" class="hover:text-tide-accent transition-colors">Live Preview</a></li>
          <li><a href="/#themes" class="hover:text-tide-accent transition-colors">Themes</a></li>
          <li><a href="/#compatibility" class="hover:text-tide-accent transition-colors">Compatibility</a></li>
          <li><a href="/docs" class="text-tide-accent font-bold hover:underline transition-colors">Documentation</a></li>
        </ul>
      </div>

      <!-- Col 3: Ecosystem -->
      <div class="space-y-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-tide-text">Ecosystem</div>
        <ul class="space-y-1.5 text-[11px] text-tide-muted">
          <li><a href="https://github.com/sadia/TIDE" target="_blank" class="hover:text-tide-accent transition-colors">GitHub Repository</a></li>
          <li><a href="https://github.com/sadia/TIDE/issues" target="_blank" class="hover:text-tide-accent transition-colors">Issue Tracker</a></li>
          <li><a href="/docs" class="hover:text-tide-accent transition-colors">Documentation</a></li>
        </ul>
      </div>

      <!-- Col 4: Anti-Slop Pledge -->
      <div class="space-y-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-tide-text">Craft Pledge</div>
        <p class="text-[11px] text-tide-muted leading-relaxed font-sans">
          Zero marketing fluff, zero bloated Electron wrappers, zero hallucinated status. Strictly engineered native systems software for engineers.
        </p>
        <div class="text-[10px] text-tide-muted font-mono pt-1">
          Open Source under MIT / Apache-2.0
        </div>
      </div>
    </div>

    <!-- Bottom Line -->
    <div class="pt-6 border-t border-tide-border flex flex-col sm:flex-row items-center justify-between text-[11px] text-tide-muted gap-2">
      <div>
        © 2026 TIDE Project. Native, keyboard-first terminal workspace.
      </div>
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-tide-success"></span>
          <span>Buffer Clean</span>
        </span>
        <span>•</span>
        <span>0 Orphaned Processes</span>
      </div>
    </div>
  </div>
</footer>
