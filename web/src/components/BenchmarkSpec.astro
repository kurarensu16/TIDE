---
// BenchmarkSpec.astro - Empirical Systems Performance & Capability Specifications
---

<section id="benchmarks" class="py-20 border-b border-tide-border bg-tide-surface/30 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="text-xs uppercase tracking-widest text-tide-accent font-mono mb-2 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-tide-accent"></span>
        <span>// Performance Spec Sheet</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-tide-text mb-4">
        Native Rust speed.<br />
        <span class="text-tide-accent terminal-glow">Zero Chromium bloat. Zero DOM overhead.</span>
      </h2>
      <p class="text-sm sm:text-base text-tide-text-secondary leading-relaxed font-sans">
        Your CPU cores and RAM should be executing LLM test suites, rustc builds, and agent reasoning loops — not painting multi-megabyte DOM node trees and running heavy Electron background helpers.
      </p>
    </div>

    <!-- Comparative Benchmark Table with Category Filters -->
    <div class="rounded-lg border border-tide-border bg-tide-surface overflow-hidden font-mono text-xs shadow-lg">
      <div class="p-4 bg-tide-variant/60 border-b border-tide-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="font-bold text-tide-text text-sm flex items-center gap-2">
          <span>📊</span>
          <span>Empirical Systems Benchmark Sheet</span>
        </div>
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px]" id="benchmark-filter-tabs">
          <button data-filter="all" class="bench-filter-btn px-2.5 py-1 rounded bg-tide-tab-active-bg text-tide-tab-active-fg font-bold border border-tide-border-active transition-all">
            All (6)
          </button>
          <button data-filter="perf" class="bench-filter-btn px-2.5 py-1 rounded bg-tide-surface hover:bg-tide-variant text-tide-text-secondary transition-all">
            Speed & Latency
          </button>
          <button data-filter="memory" class="bench-filter-btn px-2.5 py-1 rounded bg-tide-surface hover:bg-tide-variant text-tide-text-secondary transition-all">
            Memory & Binary
          </button>
          <button data-filter="kernel" class="bench-filter-btn px-2.5 py-1 rounded bg-tide-surface hover:bg-tide-variant text-tide-text-secondary transition-all">
            Kernel Safety
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="benchmark-table">
          <thead>
            <tr class="border-b border-tide-border bg-tide-surface text-tide-text uppercase tracking-wider text-[11px]">
              <th class="p-4 font-bold">Metric / Capability</th>
              <th class="p-4 font-bold text-tide-accent flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-tide-accent"></span>
                TIDE (Native Rust Binary)
              </th>
              <th class="p-4 font-bold text-tide-muted">Typical Electron / Web GUI</th>
              <th class="p-4 font-bold text-tide-text-secondary">Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-tide-border text-tide-text-secondary">
            <!-- Row 1: Cold Startup -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="perf">
              <td class="p-4 font-semibold text-tide-text">
                <div>Cold Startup to Interactive Prompt</div>
                <div class="text-[10px] text-tide-muted font-sans">Time elapsed from binary exec to first ready keystroke</div>
              </td>
              <td class="p-4 text-tide-success font-bold text-sm">&lt; 480 ms</td>
              <td class="p-4 text-tide-muted">3,800 ms – 6,500 ms</td>
              <td class="p-4 text-tide-accent font-bold text-[11px]">8.7x Faster</td>
            </tr>

            <!-- Row 2: Idle RAM -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="memory">
              <td class="p-4 font-semibold text-tide-text">
                <div>Idle Base RAM Footprint (3 sessions)</div>
                <div class="text-[10px] text-tide-muted font-sans">Resident working set memory on clean launch</div>
              </td>
              <td class="p-4 text-tide-success font-bold text-sm">~14 MB</td>
              <td class="p-4 text-tide-danger font-semibold">450 MB – 1,200 MB</td>
              <td class="p-4 text-tide-accent font-bold text-[11px]">39x Lighter</td>
            </tr>

            <!-- Row 3: Keystroke Latency -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="perf">
              <td class="p-4 font-semibold text-tide-text">
                <div>Keystroke Echo Latency (P95)</div>
                <div class="text-[10px] text-tide-muted font-sans">Hardware keypress to ConPTY terminal screen refresh</div>
              </td>
              <td class="p-4 text-tide-success font-bold text-sm">&lt; 25 ms</td>
              <td class="p-4 text-tide-muted">65 ms – 140 ms</td>
              <td class="p-4 text-tide-accent font-bold text-[11px]">Sub-frame Echo</td>
            </tr>

            <!-- Row 4: Process Teardown -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="kernel">
              <td class="p-4 font-semibold text-tide-text">
                <div>Windows Process Tree Teardown</div>
                <div class="text-[10px] text-tide-muted font-sans">Behavior when terminating an agent with child compilers</div>
              </td>
              <td class="p-4 text-tide-accent font-bold">
                <span class="px-2 py-0.5 rounded bg-tide-accent/15 border border-tide-accent/40 text-tide-accent inline-block">
                  Kernel Job Object (Guaranteed 100%)
                </span>
              </td>
              <td class="p-4 text-tide-danger">
                SIGTERM / Frequently leaves orphan locks
              </td>
              <td class="p-4 text-tide-success font-bold text-[11px]">0 Leaked Locks</td>
            </tr>

            <!-- Row 5: Heavy Log Pacing -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="perf">
              <td class="p-4 font-semibold text-tide-text">
                <div>Heavy Log Output Pacing (100k ANSI/s)</div>
                <div class="text-[10px] text-tide-muted font-sans">UI responsiveness during compiler test dumps</div>
              </td>
              <td class="p-4 text-tide-success font-bold text-sm">60 Hz Frame-Paced (Zero UI Freeze)</td>
              <td class="p-4 text-tide-muted">DOM Floods / Canvas Frame Drops</td>
              <td class="p-4 text-tide-accent font-bold text-[11px]">Decoupled PTY</td>
            </tr>

            <!-- Row 6: Bundled Runtime -->
            <tr class="bench-row hover:bg-tide-variant/30 transition-colors" data-category="memory">
              <td class="p-4 font-semibold text-tide-text">
                <div>Bundled Web Runtime (Chromium / Node.js)</div>
                <div class="text-[10px] text-tide-muted font-sans">Unnecessary browser engine bloat in distribution package</div>
              </td>
              <td class="p-4 text-tide-accent font-bold text-sm">0 MB (Zero runtime dependencies)</td>
              <td class="p-4 text-tide-muted">180+ MB bundled runtime</td>
              <td class="p-4 text-tide-accent font-bold text-[11px]">Single Executable</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Benchmarks Footer -->
      <div class="p-3 bg-tide-variant/40 border-t border-tide-border text-[11px] text-tide-muted flex flex-col sm:flex-row items-center justify-between gap-2">
        <span>* Measured on Windows 11 x86_64, AMD Ryzen 9 7950X, 64GB DDR5. Child agent memory reported separately.</span>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded bg-tide-bg border border-tide-border text-tide-accent font-bold">Rust Edition 2024</span>
          <span class="text-tide-success font-bold">Windows NT 10.0+</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Table Category Filter Script -->
<script>
  const filterBtns = document.querySelectorAll('.bench-filter-btn');
  const benchRows = document.querySelectorAll('.bench-row');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-filter');

      // Update active button state
      filterBtns.forEach(b => {
        b.className = 'bench-filter-btn px-2.5 py-1 rounded bg-tide-surface hover:bg-tide-variant text-tide-text-secondary transition-all';
      });
      btn.className = 'bench-filter-btn px-2.5 py-1 rounded bg-tide-tab-active-bg text-tide-tab-active-fg font-bold border border-tide-border-active transition-all';

      // Filter rows
      benchRows.forEach(row => {
        const rowCategory = row.getAttribute('data-category');
        if (category === 'all' || rowCategory === category) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
