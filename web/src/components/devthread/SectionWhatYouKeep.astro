---
// SectionWhatYouKeep.astro - 03 / WHY DEVELOPERS USE IT
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="what-you-keep" class="py-20 border-b border-tide-border bg-tide-bg relative scroll-mt-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section label -->
    <div class="text-xs uppercase tracking-widest text-tide-accent font-mono mb-4">
      03 / SYSTEMS ARCHITECTURE
    </div>

    <!-- Header Row -->
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-tide-text leading-tight font-mono mb-3">
        Zero bloat.<br />
        Systems-level precision.
      </h2>
      <p class="text-sm sm:text-base text-tide-text-secondary leading-relaxed font-sans">
        Engineered as a compact, self-contained terminal binary. No Electron runtimes, no background daemons, and zero ghost processes.
      </p>
    </div>

    <!-- Asymmetric Bento Grid (1 tall featured card left + 4 cards right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Featured Left Card (5 cols, spans 2 rows) -->
      <div class="lg:col-span-5 rounded-xl border border-tide-accent/40 bg-tide-surface p-7 flex flex-col justify-between shadow-xl relative overflow-hidden group">
        <!-- Ambient radial glow -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-tide-accent/15 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <!-- Icon / Badge -->
          <div class="w-10 h-10 rounded-lg bg-tide-variant border border-tide-border flex items-center justify-center text-tide-accent mb-6 font-mono font-bold text-sm">
            JOB
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-tide-text font-mono mb-2">
            Deterministic Process Teardown
          </h3>
          
          <div class="text-xs text-tide-accent font-mono mb-4 font-semibold">
            Win32 Job Objects & Unix Process Groups
          </div>

          <p class="text-xs sm:text-sm text-tide-text-secondary leading-relaxed font-sans mb-6">
            TIDE assigns every spawned agent child process to a dedicated Win32 Job Object configured with <code class="text-tide-accent font-mono text-[11px]">JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE</code>. Compilers, background watchers, and dev servers can never outlive their host tab.
          </p>

          <!-- Guarantees list -->
          <div class="space-y-3 font-mono text-xs border-t border-tide-border pt-5">
            <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
              <span class="text-tide-accent font-bold">100% Child Tree Teardown</span>
              <span class="text-[10px] text-tide-success">✓ Automatic</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
              <span class="text-tide-text">No Lingering Port Locks</span>
              <span class="text-[10px] text-tide-success">✓ Clean Sockets</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
              <span class="text-tide-muted">No Task Manager Scavenging</span>
              <span class="text-[10px] text-tide-accent">Guaranteed</span>
            </div>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-tide-border text-[11px] text-tide-muted font-sans flex items-center justify-between">
          <span>Protected by kernel Job Objects</span>
          <a href={`${base}/docs#jobobjects`} class="text-tide-accent hover:underline font-mono">Learn more &rarr;</a>
        </div>
      </div>

      <!-- Right 4 Cards (7 cols in a 2x2 grid) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        
        <!-- Card 1: Private Workspaces -->
        <div class="p-6 rounded-xl border border-tide-border bg-tide-surface flex flex-col justify-between hover:border-tide-border-active transition-all group">
          <div>
            <div class="text-[11px] font-mono text-tide-accent mb-2 font-bold">
              // Git Worktrees
            </div>
            <h4 class="text-base font-bold text-tide-text font-mono mb-2">
              Non-Destructive Parallel Branching
            </h4>
            <p class="text-xs text-tide-text-secondary leading-relaxed font-sans">
              Each agent executes in an isolated detached worktree. Run multiple concurrent agents while continuing your primary work without Git index locks or dirty state conflicts.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-tide-border text-[10px] text-tide-muted font-sans">
            Native Git 2.30+ worktree lifecycle
          </div>
        </div>

        <!-- Card 2: 60 FPS PTY -->
        <div class="p-6 rounded-xl border border-tide-border bg-tide-surface flex flex-col justify-between hover:border-tide-border-active transition-all group">
          <div>
            <div class="text-[11px] font-mono text-tide-accent mb-2 font-bold">
              // ConPTY Frame Pacing
            </div>
            <h4 class="text-base font-bold text-tide-text font-mono mb-2">
              Paced 60 FPS Terminal Multiplexing
            </h4>
            <p class="text-xs text-tide-text-secondary leading-relaxed font-sans">
              Output streams are batched through high-throughput ring buffers. High-frequency compiler diagnostics and LLM token streams render smoothly without locking the terminal event loop.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-tide-border text-[10px] text-tide-muted font-sans">
            Sub-25ms keyboard input latency
          </div>
        </div>

        <!-- Card 3: Simple Config -->
        <div class="p-6 rounded-xl border border-tide-border bg-tide-surface flex flex-col justify-between hover:border-tide-border-active transition-all group">
          <div>
            <div class="text-[11px] font-mono text-tide-accent mb-2 font-bold">
              // Declarative Config
            </div>
            <h4 class="text-base font-bold text-tide-text font-mono mb-2">
              Project-Scoped Agent Toolchains
            </h4>
            <p class="text-xs text-tide-text-secondary leading-relaxed font-sans">
              Define agent commands, task prompts, and hotkeys in a single <code class="text-tide-accent font-mono text-[11px]">tide.toml</code> file. Interoperate with Claude Code, Antigravity, Aider, or custom shell pipelines.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-tide-border text-[10px] text-tide-muted font-sans">
            Standard TOML configuration
          </div>
        </div>

        <!-- Card 4: 14 MB Footprint -->
        <div class="p-6 rounded-xl border border-tide-border bg-tide-surface flex flex-col justify-between hover:border-tide-border-active transition-all group">
          <div>
            <div class="text-[11px] font-mono text-tide-accent mb-2 font-bold">
              // Minimal Footprint
            </div>
            <h4 class="text-base font-bold text-tide-text font-mono mb-2">
              ~14 MB Resident & &lt;0.5s Startup
            </h4>
            <p class="text-xs text-tide-text-secondary leading-relaxed font-sans">
              Compiled to a standalone native binary in pure Rust. No webview wrappers, no V8 runtime overhead, and negligible background CPU consumption.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-tide-border text-[10px] text-tide-muted font-sans">
            Zero Electron &middot; zero Chromium dependencies
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
