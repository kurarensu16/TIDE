---
// SectionCompatibility.astro - 06 / COMPATIBILITY
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="compatibility" class="py-20 border-b border-tide-border bg-tide-bg relative scroll-mt-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section label -->
    <div class="text-xs uppercase tracking-widest text-tide-accent font-mono mb-4">
      04 / COMPATIBILITY
    </div>

    <!-- 2-Column Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Headline & Systems Narrative -->
      <div class="lg:col-span-5 space-y-4">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-tide-text leading-tight font-mono">
          Compatibility matrix & systems footprint.
        </h2>
        <p class="text-sm sm:text-base text-tide-text-secondary leading-relaxed font-sans">
          Engineered without Electron, web runtimes, or container dependencies. Interoperates directly with your native toolchains, shells, and repositories.
        </p>
        <div class="pt-2">
          <a
            href={`${base}/docs`}
            class="text-xs font-mono text-tide-accent hover:underline flex items-center gap-1"
          >
            <span>View technical setup & documentation</span>
            <span>↗</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Evidence Status Rows -->
      <div class="lg:col-span-7 divide-y divide-tide-border">
        
        <!-- Row 1: AI Agent CLIs -->
        <div class="py-5 first:pt-0 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-tide-text font-mono">
              Agent CLI Toolchains
            </h3>
            <p class="text-xs text-tide-text-secondary font-sans mt-0.5">
              Claude Code, Antigravity, Aider, Codex, or arbitrary terminal subprocesses
            </p>
            <div class="text-[11px] text-tide-muted font-mono mt-1">
              Configured via simple <code class="text-tide-accent font-mono text-[10px]">tide.toml</code> entries
            </div>
          </div>
          <span class="px-2.5 py-1 rounded bg-tide-success/10 border border-tide-success/30 text-tide-success font-mono text-xs font-bold shrink-0 self-start sm:self-center">
            ✓ Any CLI
          </span>
        </div>

        <!-- Row 2: Standard Git -->
        <div class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-tide-text font-mono">
              Git Subsystem
            </h3>
            <p class="text-xs text-tide-text-secondary font-sans mt-0.5">
              Standard detached worktree creation without repository modification or server hooks
            </p>
            <div class="text-[11px] text-tide-muted font-mono mt-1">
              Git 2.30+ worktrees &middot; safe branch lifecycle
            </div>
          </div>
          <span class="px-2.5 py-1 rounded bg-tide-success/10 border border-tide-success/30 text-tide-success font-mono text-xs font-bold shrink-0 self-start sm:self-center">
            ✓ Git 2.30+
          </span>
        </div>

        <!-- Row 3: Windows Native -->
        <div class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-tide-text font-mono">
              Host Platforms
            </h3>
            <p class="text-xs text-tide-text-secondary font-sans mt-0.5">
              Tier-1 Windows 10/11 x86_64 (ConPTY + Job Objects) and Unix process group parity
            </p>
            <div class="text-[11px] text-tide-muted font-mono mt-1">
              Native kernel boundaries &middot; zero virtualization overhead
            </div>
          </div>
          <span class="px-2.5 py-1 rounded bg-tide-success/10 border border-tide-success/30 text-tide-success font-mono text-xs font-bold shrink-0 self-start sm:self-center">
            ✓ Native OS
          </span>
        </div>

        <!-- Row 4: Starts in under 0.5s -->
        <div class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-tide-text font-mono">
              Cold Boot Latency (&lt;0.5s)
            </h3>
            <p class="text-xs text-tide-text-secondary font-sans mt-0.5">
              Initializes TUI context and terminal multiplexer in under 480 milliseconds
            </p>
            <div class="text-[11px] text-tide-muted font-mono mt-1">
              Instant command execution
            </div>
          </div>
          <span class="px-2.5 py-1 rounded bg-tide-accent/10 border border-tide-accent/30 text-tide-accent font-mono text-xs font-bold shrink-0 self-start sm:self-center">
            ✓ &lt;0.5s Boot
          </span>
        </div>

        <!-- Row 5: Memory -->
        <div class="py-5 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h3 class="text-sm sm:text-base font-bold text-tide-text font-mono">
              Resident Memory (~14 MB)
            </h3>
            <p class="text-xs text-tide-text-secondary font-sans mt-0.5">
              Pure Rust memory footprint with zero Chromium or Node runtime allocation
            </p>
            <div class="text-[11px] text-tide-muted font-mono mt-1">
              Single compact process
            </div>
          </div>
          <span class="px-2.5 py-1 rounded bg-tide-variant border border-tide-border text-tide-text font-mono text-xs font-bold shrink-0 self-start sm:self-center">
            ✓ ~14 MB RAM
          </span>
        </div>

      </div>

    </div>

  </div>
</section>
