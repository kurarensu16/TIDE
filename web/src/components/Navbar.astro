---
// Navbar.astro - Full-Width Edge-to-Edge with Centered Topbar Navigation
---

<header class="sticky top-0 z-50 border-b border-tide-border bg-tide-surface/85 backdrop-blur-md transition-colors w-full">
  <div class="w-full px-4 sm:px-6 lg:px-10 h-14 flex items-center justify-between relative">
    <!-- Left: Brand (uses up left margin) -->
    <a href="/" class="flex items-center group z-10">
      <span class="font-bold text-lg tracking-widest text-tide-text group-hover:text-tide-accent group-hover:terminal-glow transition-colors font-mono">
        TIDE
      </span>
    </a>

    <!-- Center: Topbar Contents placed in the exact middle -->
    <nav class="hidden md:flex items-center gap-8 text-xs uppercase tracking-wider text-tide-text-secondary font-mono absolute left-1/2 -translate-x-1/2">
      <a href="/#how-it-works" class="hover:text-tide-accent transition-colors">
        How it works
      </a>
      <a href="/#workspace" class="hover:text-tide-accent transition-colors">
        Live Preview
      </a>
      <a href="/docs" class="text-tide-accent font-bold hover:text-white transition-colors">
        Docs
      </a>
    </nav>

    <!-- Right: Actions (uses up right margin) -->
    <div class="flex items-center gap-3 z-10">
      <a
        href="https://github.com/sadia/TIDE"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 px-3 py-1.5 text-xs border border-tide-border hover:border-tide-border-active bg-tide-surface text-tide-text rounded font-mono hover:text-tide-accent transition-all"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
        <span class="text-tide-muted text-[10px]">↗</span>
      </a>

      <a
        href="#install"
        class="flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded bg-tide-accent text-tide-bg hover:brightness-110 shadow-sm transition-all font-mono"
      >
        <span>Install TIDE</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</header>
