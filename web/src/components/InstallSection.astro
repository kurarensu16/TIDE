---
// InstallSection.astro
---

<section id="install" class="py-20 border-b border-tide-border bg-tide-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <div class="text-xs uppercase tracking-widest text-tide-accent font-mono mb-2">
        // Installation & Quickstart
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-tide-text mb-4">
        Ready in seconds. Single standalone binary.
      </h2>
      <p class="text-sm sm:text-base text-tide-text-secondary leading-relaxed">
        Choose your preferred distribution channel. Zero compiler or toolchain prerequisites needed for pre-built installers.
      </p>
    </div>

    <!-- Installation Tabs -->
    <div class="max-w-4xl rounded-lg border border-tide-border bg-tide-surface overflow-hidden font-mono text-xs">
      <!-- Tabs header -->
      <div class="h-10 bg-tide-variant border-b border-tide-border flex items-center px-2 gap-1 overflow-x-auto" id="install-tabs">
        <button data-tab="powershell" class="install-tab-btn px-3 py-1.5 rounded-t bg-tide-bg border-t border-x border-tide-border-active text-tide-accent font-bold transition-all">
          PowerShell (Windows)
        </button>
        <button data-tab="shell" class="install-tab-btn px-3 py-1.5 text-tide-text-secondary hover:text-tide-text transition-all">
          Shell (macOS / Linux)
        </button>
        <button data-tab="packages" class="install-tab-btn px-3 py-1.5 text-tide-text-secondary hover:text-tide-text transition-all">
          Package Managers
        </button>
        <button data-tab="cargo" class="install-tab-btn px-3 py-1.5 text-tide-text-secondary hover:text-tide-text transition-all">
          Cargo (Rust)
        </button>
        <button data-tab="releases" class="install-tab-btn px-3 py-1.5 text-tide-text-secondary hover:text-tide-text transition-all">
          Prebuilt Binaries
        </button>
      </div>

      <!-- Tab Content Panels -->
      <div class="p-6">
        <!-- PowerShell Tab (Default) -->
        <div id="tab-powershell" class="install-panel space-y-4">
          <div class="text-tide-text-secondary">
            One-line automated installer for Windows. Downloads the standalone binary to <code class="text-tide-text">~/.tide/bin</code> and adds it to your User PATH:
          </div>
          <div class="flex items-center justify-between p-3 rounded bg-tide-bg border border-tide-border group">
            <code class="text-tide-accent text-xs sm:text-sm select-all break-all">irm https://raw.githubusercontent.com/kurarensu16/TIDE/main/scripts/install.ps1 | iex</code>
            <button class="copy-cmd-btn ml-2 shrink-0 px-2.5 py-1 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-xs transition-colors" data-copy="irm https://raw.githubusercontent.com/kurarensu16/TIDE/main/scripts/install.ps1 | iex">
              Copy
            </button>
          </div>
          <div class="text-[11px] text-tide-muted flex flex-wrap items-center justify-between gap-2">
            <span>✓ No Rust toolchain or compilation required</span>
            <span>Windows 10 / 11 (x86_64)</span>
          </div>
        </div>

        <!-- Shell (macOS / Linux) Tab -->
        <div id="tab-shell" class="install-panel hidden space-y-4">
          <div class="text-tide-text-secondary">
            One-line installer for macOS and Linux. Detects system architecture and places the executable into <code class="text-tide-text">~/.local/bin</code>:
          </div>
          <div class="flex items-center justify-between p-3 rounded bg-tide-bg border border-tide-border group">
            <code class="text-tide-accent text-xs sm:text-sm select-all break-all">curl -fsSL https://raw.githubusercontent.com/kurarensu16/TIDE/main/scripts/install.sh | sh</code>
            <button class="copy-cmd-btn ml-2 shrink-0 px-2.5 py-1 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-xs transition-colors" data-copy="curl -fsSL https://raw.githubusercontent.com/kurarensu16/TIDE/main/scripts/install.sh | sh">
              Copy
            </button>
          </div>
          <div class="text-[11px] text-tide-muted flex flex-wrap items-center justify-between gap-2">
            <span>✓ Supports macOS Apple Silicon (ARM64), Intel (x86_64), and Linux x86_64</span>
            <span>Installs to: <code class="text-tide-text">~/.local/bin/tide</code></span>
          </div>
        </div>

        <!-- Package Managers Tab -->
        <div id="tab-packages" class="install-panel hidden space-y-4">
          <div class="text-tide-text-secondary">
            Install via your favorite developer package manager:
          </div>
          
          <div class="space-y-3">
            <div>
              <div class="text-[11px] text-tide-muted mb-1 font-bold">Scoop (Windows):</div>
              <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
                <code class="text-tide-accent select-all break-all text-xs">scoop install https://raw.githubusercontent.com/kurarensu16/TIDE/main/packaging/scoop/tide.json</code>
                <button class="copy-cmd-btn ml-2 shrink-0 px-2 py-0.5 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-[11px]" data-copy="scoop install https://raw.githubusercontent.com/kurarensu16/TIDE/main/packaging/scoop/tide.json">Copy</button>
              </div>
            </div>

            <div>
              <div class="text-[11px] text-tide-muted mb-1 font-bold">Winget (Windows):</div>
              <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
                <code class="text-tide-accent select-all text-xs">winget install kurarensu16.tide</code>
                <button class="copy-cmd-btn ml-2 shrink-0 px-2 py-0.5 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-[11px]" data-copy="winget install kurarensu16.tide">Copy</button>
              </div>
            </div>

            <div>
              <div class="text-[11px] text-tide-muted mb-1 font-bold">Homebrew (macOS / Linux):</div>
              <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
                <code class="text-tide-accent select-all text-xs">brew install kurarensu16/tide</code>
                <button class="copy-cmd-btn ml-2 shrink-0 px-2 py-0.5 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-[11px]" data-copy="brew install kurarensu16/tide">Copy</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Cargo Tab -->
        <div id="tab-cargo" class="install-panel hidden space-y-4">
          <div class="text-tide-text-secondary">
            For Rust developers. Download pre-compiled binary via cargo-binstall or compile from git:
          </div>
          <div class="space-y-3">
            <div>
              <div class="text-[11px] text-tide-muted mb-1">Instant pre-built download via cargo-binstall:</div>
              <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
                <code class="text-tide-accent select-all text-xs">cargo binstall --git https://github.com/kurarensu16/TIDE tide</code>
                <button class="copy-cmd-btn ml-2 shrink-0 px-2 py-0.5 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-[11px]" data-copy="cargo binstall --git https://github.com/kurarensu16/TIDE tide">Copy</button>
              </div>
            </div>
            <div>
              <div class="text-[11px] text-tide-muted mb-1">Compile from source (requires Rust 1.85+):</div>
              <div class="flex items-center justify-between p-2.5 rounded bg-tide-bg border border-tide-border">
                <code class="text-tide-accent select-all text-xs">cargo install --git https://github.com/kurarensu16/TIDE.git</code>
                <button class="copy-cmd-btn ml-2 shrink-0 px-2 py-0.5 rounded bg-tide-variant border border-tide-border text-tide-muted hover:text-tide-text text-[11px]" data-copy="cargo install --git https://github.com/kurarensu16/TIDE.git">Copy</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Releases Tab -->
        <div id="tab-releases" class="install-panel hidden space-y-4">
          <div class="text-tide-text-secondary">
            Download standalone portable executables directly from GitHub Releases:
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <a href="https://github.com/kurarensu16/TIDE/releases/latest" target="_blank" class="p-3 rounded border border-tide-border hover:border-tide-border-active bg-tide-bg hover:bg-tide-variant/40 transition-all flex items-center justify-between">
              <div>
                <div class="font-bold text-tide-text">Windows x86_64 (.zip)</div>
                <div class="text-[10px] text-tide-muted">Standalone tide.exe with icon</div>
              </div>
              <span class="text-tide-accent font-bold">↓</span>
            </a>
            <a href="https://github.com/kurarensu16/TIDE/releases/latest" target="_blank" class="p-3 rounded border border-tide-border hover:border-tide-border-active bg-tide-bg hover:bg-tide-variant/40 transition-all flex items-center justify-between">
              <div>
                <div class="font-bold text-tide-text">Linux x86_64 (.tar.gz)</div>
                <div class="text-[10px] text-tide-muted">Portable glibc release binary</div>
              </div>
              <span class="text-tide-accent font-bold">↓</span>
            </a>
            <a href="https://github.com/kurarensu16/TIDE/releases/latest" target="_blank" class="p-3 rounded border border-tide-border hover:border-tide-border-active bg-tide-bg hover:bg-tide-variant/40 transition-all flex items-center justify-between">
              <div>
                <div class="font-bold text-tide-text">macOS Apple Silicon (.tar.gz)</div>
                <div class="text-[10px] text-tide-muted">ARM64 (M1/M2/M3/M4)</div>
              </div>
              <span class="text-tide-accent font-bold">↓</span>
            </a>
            <a href="https://github.com/kurarensu16/TIDE/releases/latest" target="_blank" class="p-3 rounded border border-tide-border hover:border-tide-border-active bg-tide-bg hover:bg-tide-variant/40 transition-all flex items-center justify-between">
              <div>
                <div class="font-bold text-tide-text">macOS Intel (.tar.gz)</div>
                <div class="text-[10px] text-tide-muted">x86_64 Darwin</div>
              </div>
              <span class="text-tide-accent font-bold">↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Launch Snippet -->
      <div class="p-4 bg-tide-variant/30 border-t border-tide-border text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="text-tide-text-secondary">
          <span class="text-tide-muted">Launch any workspace:</span> <code class="text-tide-accent font-bold">tide .</code>
        </div>
        <div class="flex items-center gap-2 text-tide-muted text-[11px]">
          <span>Requirements: Git 2.30+</span>
          <span>•</span>
          <span>Windows 10/11, Linux, macOS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switching script
  const tabButtons = document.querySelectorAll('.install-tab-btn');
  const panels = document.querySelectorAll('.install-panel');
  const copyButtons = document.querySelectorAll('.copy-cmd-btn');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');

      // Update button styles
      tabButtons.forEach(b => {
        b.className = 'install-tab-btn px-3 py-1.5 text-tide-text-secondary hover:text-tide-text transition-all';
      });
      btn.className = 'install-tab-btn px-3 py-1.5 rounded-t bg-tide-bg border-t border-x border-tide-border-active text-tide-accent font-bold transition-all';

      // Show target panel
      panels.forEach(p => p.classList.add('hidden'));
      const activePanel = document.getElementById(`tab-${tab}`);
      if (activePanel) activePanel.classList.remove('hidden');
    });
  });

  // Copy command script
  copyButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('text-tide-success');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('text-tide-success');
        }, 1800);
      }
    });
  });
</script>
